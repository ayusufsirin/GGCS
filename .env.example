# GGCS local Docker/Compose configuration
#
# Copy this file only when you need overrides:
#   cp .env.example .env
#
# `.env` is intentionally ignored by Git.
# If `.env` does not exist, or any NEXUS_* value below is empty, GGCS uses
# the normal public upstream for that registry/package manager.

# -----------------------------------------------------------------------------
# GGCS versions / local ports
# -----------------------------------------------------------------------------
GGCS_NODE_VERSION=22.23.2
GGCS_PNPM_VERSION=10.34.5
GGCS_WEB_DEV_PORT=3000
GGCS_WEB_PROD_PORT=8080
GGCS_ROSBRIDGE_PORT=9090
REACT_APP_GGCS_ROSBRIDGE_URL=ws://localhost:9090
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_LOCALHOST_ONLY=0

# -----------------------------------------------------------------------------
# Optional Nexus proxies
# Leave any value blank to use the corresponding public upstream directly.
# -----------------------------------------------------------------------------

# Docker registry/group prefix. Do NOT include https://.
# Examples:
#   nexus.example.com/repository/docker-all
#   nexus.example.com:5000
# Empty fallback: docker.io
NEXUS_DOCKER_REGISTRY=

# npm group/proxy endpoint used by npm, pnpm and Corepack.
# Example: https://nexus.example.com/repository/npm-all/
# Empty fallback: https://registry.npmjs.org/
NEXUS_NPM_REGISTRY=

# PyPI group/proxy simple-index endpoint.
# Example: https://nexus.example.com/repository/pypi-all/simple
# Empty fallback: https://pypi.org/simple
NEXUS_PYPI_INDEX_URL=

# Debian APT proxies (Node/bookworm images).
# Examples:
#   https://nexus.example.com/repository/apt-debian
#   https://nexus.example.com/repository/apt-debian-security
NEXUS_APT_DEBIAN_URL=
NEXUS_APT_DEBIAN_SECURITY_URL=

# Ubuntu APT proxies (ROS/Ubuntu images).
# Examples:
#   https://nexus.example.com/repository/apt-ubuntu
#   https://nexus.example.com/repository/apt-ubuntu-security
#   https://nexus.example.com/repository/apt-ubuntu-ports
NEXUS_APT_UBUNTU_URL=
NEXUS_APT_UBUNTU_SECURITY_URL=
NEXUS_APT_UBUNTU_PORTS_URL=

# ROS 2 APT proxy.
# Example: https://nexus.example.com/repository/apt-ros2
NEXUS_APT_ROS2_URL=
